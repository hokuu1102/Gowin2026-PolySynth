<?xml version="1" encoding="UTF-8"?>
<!DOCTYPE gowin-fpga-project>
<!--
  synth_check.gprj - project used ONLY for the "does every module synthesise?" check
  (see bringup/01-*.md section 3-5 and K-46).

  WHY A SEPARATE PROJECT:
    Gowin only COMPILES modules reachable from the top module. A file that is merely
    listed gets "Analyzing ..." but NOT "Compiling module ...", so being listed is NOT
    evidence of being synthesisable (K-46).  This project's top is
    bringup/synth_check_top.v, which instantiates every module we want checked.

  NOTE: synthesis only (no .cst needed, no bitstream, no board).
  NOTE: keep this file ASCII-only for the Chinese-free paths we need here.
-->
<Project>
    <Template>FPGA</Template>
    <Version>5</Version>
    <Device name="GW5AT-60B" pn="GW5AT-LV60PG484AC2/I1">gw5at60b-003</Device>
    <FileList>
        <File path="../ip/wavetable_sine_rom_ip/wavetable_sine_rom_ip.v" type="file.verilog" enable="1"/>
        <File path="../rtl/clk_gen.v" type="file.verilog" enable="1"/>
        <File path="../rtl/rst_sync.v" type="file.verilog" enable="1"/>
        <File path="../rtl/sync_input.v" type="file.verilog" enable="1"/>
        <File path="../rtl/w3c/i2s_tx.v" type="file.verilog" enable="1"/>
        <!-- T32: beat_gen (PPQN=960 musical clock -- shared timebase for the
             metronome, drum machine and looper).  Added here as well as to the
             delivery path so it is covered by the "does every module really
             synthesise?" check (K-46 / K-91). -->
        <File path="../rtl/w3c/beat_gen.v" type="file.verilog" enable="1"/>
        <!-- T33: metronome (synthetic click on the EXISTING event path) and -->
        <!-- perc_env_bank (one-shot percussion envelope; envelope_bank/adsr is -->
        <!-- an ADSR with sustain, so it cannot make a 10-20 ms click). -->
        <File path="../rtl/w3c/metronome.v" type="file.verilog" enable="1"/>
        <File path="../rtl/w3c/perc_env_bank.v" type="file.verilog" enable="1"/>
        <!-- Score-download front end: UART receiver.  Ported from an already -->
        <!-- working project (ADDA); only the reset style was made synchronous -->
        <!-- to match freeze-table convention 2. -->
        <File path="../rtl/w3c/uart_rx.v" type="file.verilog" enable="1"/>
        <File path="../rtl/drivers/tlc5916_driver.sv" type="file.verilog" enable="1"/>
        <File path="../rtl/w3b/wavetable_bank.v" type="file.verilog" enable="1"/>
        <File path="../rtl/w3b/adsr.v" type="file.verilog" enable="1"/>
        <File path="../rtl/w3b/envelope_bank.v" type="file.verilog" enable="1"/>
        <File path="../rtl/w3b/dds_wavetable_core.v" type="file.verilog" enable="1"/>
        <File path="../rtl/w3b/voice.v" type="file.verilog" enable="1"/>
        <File path="../rtl/w3b/voice_i2s_chain.v" type="file.verilog" enable="1"/>
        <!-- T54: note_manager (W3b voice allocation / stealing / parameter update).
             Added here as well as in the main project so it is covered by the
             "does every module really synthesise?" check (K-46 / K-91). -->
        <File path="../rtl/w3b/note_manager.v" type="file.verilog" enable="1"/>
        <!-- T55: 64 independent oscillators (the throughput figure the judges check). -->
        <File path="../rtl/w3b/oscillator_bank.v" type="file.verilog" enable="1"/>
        <!-- T56: TDM render mixer (shared single multiplier + saturation). -->
        <File path="../rtl/w3b/tdm_render_mixer.v" type="file.verilog" enable="1"/>
        <!-- ⭐ L8 acquisition chain (T47 / K-90): these three modules were in NO
             Gowin project before, so they had simulation evidence only.
             mcp3208_driver/scanner are the dependencies adc_farm instantiates. -->
        <File path="../rtl/drivers/mcp3208_driver.sv" type="file.verilog" enable="1"/>
        <File path="../rtl/drivers/mcp3208_scanner.sv" type="file.verilog" enable="1"/>
        <File path="../rtl/drivers/adc_farm.sv" type="file.verilog" enable="1"/>
        <File path="../rtl/drivers/calib.sv" type="file.verilog" enable="1"/>
        <File path="../rtl/drivers/debounce.sv" type="file.verilog" enable="1"/>
        <File path="../bringup/synth_check_top.v" type="file.verilog" enable="1"/>
    </FileList>
</Project>
