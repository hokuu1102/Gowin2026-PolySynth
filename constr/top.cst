// ─────────────────────────────────────────────────────────────────────────────
// constr/top.cst · 引脚约束（Tang Mega 60K Dock）
//
// ⭐ 每一条都来自**官方 60K 引脚约束**
//    （`files/开发板原理图/tang_mega_60K_pins.cst`，Sipeed 官方，本地有、被 gitignore），
//    ⛔ 不是估的、也不是从旧基石板抄的。
//
// ⚠️ 本文件只写"M0 用到的脚"。左/右手区板、TLC5916、编码器、按键、屏等
//    要等 `files/10-硬件/硬件接口总表.md` 的 `J1`~`J11` 冻结后再补（属 T23/UI 预留）。
// ─────────────────────────────────────────────────────────────────────────────

//====== SYS ======
// 系统时钟 50 MHz（⛔ 不是旧基石板的 F13）
IO_LOC  "clk"   V22;
IO_PORT "clk"   IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// 复位按钮（官方示例的复位脚；⚠️ 原候选 Y12 其实是 Key_in[1]）
IO_LOC  "rst_n" AA13;
IO_PORT "rst_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

//====== AUDIO ======（板载 DAC = PT8211-S + 功放 NS4263，⛔ 不需要 MCLK）
IO_LOC  "HP_BCK" Y17;
IO_PORT "HP_BCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "HP_WS"  AB17;
IO_PORT "HP_WS"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

IO_LOC  "HP_DIN" AA16;
IO_PORT "HP_DIN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// ⭐⭐ 功放模式脚（🔴 **2026-09-22 换板后：脚 + 极性 + 电平 全变了**）。
//
//   🔴 **旧（`NEO Dock` / `NS4263`）**：`PA_EN_n = AB16`，**低有效**，
//      且是**"一线脉冲控制"**（1 个下降沿 = AB 类 / 2 个 = D 类 / 高 = 关断）。
//      ⚠️ **该整套语义在 Console 上【不存在】**。
//
//   ⭐ **新（`Tang Console 60K` / `MAX98357A`）**：
//     · ⭐ **真脚 = `Y14`**（SOM pin 52）。🔴 **⛔ 不是 `AB16`** ——
//       Console 上 `AB16` 是 **`USB_TERM_RXDN`**（⚠️ 驱动它会**扰动 USB 终端电阻**）。
//     · ⭐ `PA_EN` 网络经 `R54 (0R)` **直连 `MAX98357A` 的 `SD_MODE`**，
//       ⚠️ 该网络只有 **`R89 51K` 下拉**（⛔ **不是分压** ⇒ 电平完全由此脚决定）。
//     · 🔴 **`SD_MODE` 是多电平输入**（⭐ 手册）：
//         `< 0.16 V` = **`Shutdown`（没声音）** · `0.16~0.77 V` = **(L+R)/2**
//         · `0.77~1.4 V` = Right · `> 1.4 V` = Left
//       ⇒ ⭐⭐ **要出声必须驱动【高】**，⛔ **不是低**（⚠️ 低 = 静音）。
//     · ⚠️ `SD_MODE` **内部有 `100 kΩ` 下拉** ⇒ ⛔ **悬空也是 `Shutdown`**
//       ⇒ ⭐ **必须有明确的高电平驱动**，⛔ 不能靠悬空。
//
//   🔴 **电平硬约束**：`Y14` 属 **`BANK9` = 1.5 V**
//     ⇒ ⛔ **必须写 `LVCMOS15` / `BANK_VCCIO=1.5`**。
//     ⚠️ 写成 3.3 V 会**与同 bank 的 `rst_n`(`AA13`) 冲突，并可能损伤 IO**。
//     ⭐ 驱动高 ≈ `1.3~1.5 V` ⇒ 落到 **Right 或 Left 档**，
//       而 `top.v` 里 `sample_l`/`sample_r` 接的是**同一个 `sample_mono`**
//       ⇒ ⭐ **两档都能出声**（⚠️ 具体落哪档可上板实测）。
//
//   ⚠️ **`PULL_MODE=UP` 保留**：⭐ 它保证"配置期间即为高"，
//      ⚠️ 而高在这块板上**恰好是"出声"那一侧** ⇒ ⭐ 依然是安全态。
//
//   🔴 **TODO（⚠️ 必须与本次 `.cst` 一起改，否则板子仍然没声音）**：
//     `rtl/top.v` 里 `pa_en_n_r` 目前是**旧极性**（`PA_ON_AFTER_RESET=1` 时拉**低**）
//     ⇒ ⚠️ **必须改成拉【高】**，并去掉 `pa_done` 那套"只允许 1 个下降沿"的逻辑。
//     ⚠️ 该改动落在 `rtl/top.v`（⚠️ 变异测试正在改它）⇒ **等变异测试跑完再做**。
//     ⭐ 详见 `files/10-硬件/板卡替换评估/Console引脚查证-20260922.md` §一。
IO_LOC  "PA_EN_n" Y14;
IO_PORT "PA_EN_n" IO_TYPE=LVCMOS15 PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.5;

//====== LEDS ======
//   🔴 **2026-09-22 换板修正**：旧脚 `T18` 在 Console 上是 **`SDRAM1_D6`**
//      ⇒ ⚠️ 驱动它**不会点亮任何用户灯**（⭐ 白心跳，等于没有）。
//   ⭐ **新脚 = `V13`**：Console 的 `CFG_LED`（RGB）**绿路 = `SYS_ACT` = `V13`**，
//      ⭐ 它是板上**唯一**由 FPGA 驱动的用户可见灯
//      （⚠️ 红 = `READY`、蓝 = `DONE` 由配置逻辑驱动，⛔ 我们碰不到）。
IO_LOC  "led_heartbeat" V13;
IO_PORT "led_heartbeat" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
